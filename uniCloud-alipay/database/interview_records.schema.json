{
  "bsonType": "object",
  "required": ["username", "mode", "question_type", "question", "answer"],
  "permission": {
    "read": true,
    "create": true,
    "update": true,
    "delete": true
  },
  "properties": {
    "_id": { "description": "ID" },
    "username": { "bsonType": "string", "description": "用户名" },
    "mode": { "bsonType": "string", "description": "模式", "enum": ["free", "exam"] },
    "question_type": { "bsonType": "string", "description": "题型" },
    "question": { "bsonType": "string", "description": "题目文本" },
    "answer": { "bsonType": "string", "description": "用户答案" },
    "review": { "bsonType": "string", "description": "AI点评" },
    "scores": {
      "bsonType": "object",
      "description": "五维度评分",
      "properties": {
        "framework": { "bsonType": "int", "description": "答题框架 1-10" },
        "content": { "bsonType": "int", "description": "内容充实 1-10" },
        "politics": { "bsonType": "int", "description": "政治素养 1-10" },
        "expression": { "bsonType": "int", "description": "语言表达 1-10" },
        "innovation": { "bsonType": "int", "description": "创新亮点 1-10" }
      }
    },
    "total_score": { "bsonType": "double", "description": "综合评分" },
    "duration": { "bsonType": "int", "description": "答题用时(秒)" },
    "create_time": { "bsonType": "timestamp", "description": "创建时间" }
  }
}
