{
  "bsonType": "object",
  "required": ["username"],
  "permission": {
    "read": true,
    "create": true,
    "update": true,
    "delete": true
  },
  "properties": {
    "_id": { "description": "ID" },
    "username": { "bsonType": "string", "description": "用户名（唯一）" },
    "totalStars": { "bsonType": "int", "description": "星星总数" },
    "mathLevel": { "bsonType": "int", "description": "算术难度等级" },
    "mathHistory": {
      "bsonType": "array",
      "description": "算术历史记录",
      "items": { "bsonType": "object" }
    },
    "currentUnit": { "bsonType": "string", "description": "当前学习单元" },
    "updatedAt": { "bsonType": "timestamp", "description": "最后更新时间" }
  }
}
